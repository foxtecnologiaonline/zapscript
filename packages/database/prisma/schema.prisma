generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String          @id @default(cuid())
  email                       String          @unique
  name                        String?
  phone                       String?                   // Celular de contato (opcional)
  document                    String?                   // CPF/CNPJ (AES-256-GCM encrypted)
  documentHash                String?         @unique   // HMAC-SHA256 blind index (busca de duplicata)
  emailVerified               Boolean         @default(false)
  refCode                     String          @unique @default(cuid())
  referredBy                  String?
  isAdmin                     Boolean         @default(false)
  isTester                    Boolean         @default(false)
  testerSince                 DateTime?
  // LGPD - Consentimentos e direitos do usuário
  privacyPolicyAcceptedAt     DateTime?
  termsAcceptedAt             DateTime?
  contractAcceptedAt          DateTime?       // Contrato de Prestação de Serviços
  marketingConsentAt          DateTime?       // Consentimento opcional de marketing
  consentDocVersion           String?         // ex: "tos_v2.0,contrato_v2.0,pp_v2.0"
  deletedAt                   DateTime?       // Soft delete
  pseudonymizedAt             DateTime?       // LGPD: dados anonimizados
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  subscription                Subscription?
  balance                     MinuteBalance?
  numbers                     WhatsappNumber[]
  transcriptions              Transcription[]
  usageLogs                   UsageLog[]
  supportTickets              SupportTicket[]
  webhookConfig               WebhookConfig?
  npsResponses                NpsResponse[]
}

model Plan {
  id              String         @id @default(cuid())
  name            String         @unique  // "free" | "pro" | "ultra"
  label           String
  minutesPerMonth Int
  maxNumbers      Int
  priceBrl        Float
  features        Json           @default("[]")
  createdAt       DateTime       @default(now())
  subscriptions   Subscription[]
}

model Subscription {
  id                    String    @id @default(cuid())
  userId                String    @unique
  planId                String
  asaasSubscriptionId   String?   // Asaas subscription ID (sub_...)
  asaasCustomerId       String?   // Asaas customer ID (cus_...)
  paymentMethod         String?   // 'credit_card' | 'pix'
  status                String    @default("active")
  currentPeriodEnd      DateTime?
  testerRenewalsUsed    Int       @default(0)  // Renovações mensais isentas consumidas (máx 12)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  Plan      @relation(fields: [planId], references: [id])
}

model MinuteBalance {
  id                 String   @id @default(cuid())
  userId             String   @unique
  availableMinutes   Float    @default(0)
  accumulatedMinutes Float    @default(0)
  extraMinutes       Float    @default(0)  // minutos avulsos/indicação — valem 60 dias, não resetam mensalmente
  extraExpiresAt     DateTime?              // expiração do saldo extra (now + 60 dias na última recarga)
  resetAt            DateTime
  lastAlertSent      String?  // "50" | "80" | "100" — para evitar alertas duplicados
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatsappNumber {
  id               String          @id @default(cuid())
  userId           String
  phoneNumber      String           @default("pending")
  displayName      String?
  sessionEncrypted String?
  status           String           @default("disconnected")
  connectedAt      DateTime?
  lastMessageAt    DateTime?
  messageCount     Int              @default(0)
  minutesUsed      Float            @default(0)
  zapiInstanceId   String?          // sem @unique — múltiplos usuários podem compartilhar a mesma instância Z-API
  zapiToken        String?          // Token da instância Z-API criada dinamicamente
  privateMode      Boolean          @default(false)  // Modo privado: transcrição enviada ao próprio número
  // ── Conexão via API oficial da Meta (WhatsApp Cloud API / Embedded Signup) ──
  // Usado apenas para o fluxo de App Review da Meta. Usuários reais seguem no Evolution.
  provider           String         @default("evolution")  // 'evolution' | 'meta'
  metaWabaId         String?                                // WhatsApp Business Account ID
  metaPhoneNumberId  String?                                // Phone Number ID (Cloud API)
  metaBusinessId     String?                                // Business Manager ID
  metaAccessTokenEnc String?                                // Token de acesso AES-256-GCM (encryptStr)
  metaTokenExpiresAt DateTime?                              // Expiração do token (se aplicável)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcriptions   Transcription[]

  @@index([userId])             // A2: listagem de números por usuário
  @@index([zapiInstanceId])     // A2: busca de instância em webhook (hot path)
}

model Transcription {
  id              String          @id @default(cuid())
  userId          String
  numberId        String?
  contactPhone    String
  contactName     String?
  filename        String?                                // Nome original do arquivo (uploads manuais)
  durationSec     Float
  originalText    String
  summaryBullets  Json
  confidenceScore Float?
  language        String          @default("pt")
  source          String          @default("whatsapp")  // "whatsapp" | "manual"
  tags            String[]        @default([])           // Tags do usuário (Ultra+)
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  number          WhatsappNumber? @relation(fields: [numberId], references: [id], onDelete: SetNull)
  usageLog        UsageLog?

  @@index([userId])                       // A2: listagem por usuário (hot path em toda API)
  @@index([userId, createdAt(sort: Desc)]) // A2: ordenação padrão date_desc
}

model UsageLog {
  id              String         @id @default(cuid())
  userId          String
  transcriptionId String?        @unique
  minutesUsed     Float
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcription   Transcription? @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)

  @@index([userId])       // A2: aggregations de uso por usuário
  @@index([createdAt])    // A2: relatórios e agregações por período
}

model SupportTicket {
  id                  String   @id @default(cuid())
  userId              String?
  name                String
  email               String
  category            String
  description         String
  status              String   @default("open")
  attachmentUrl       String?  // Supabase Storage URL (novo)
  attachmentData      String?  // Base64 legado (manter para registros antigos)
  attachmentFilename  String?
  attachmentMimeType  String?
  createdAt           DateTime @default(now())
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemError {
  id        String   @id @default(cuid())
  service   String
  message   String
  stack     String?
  context   Json?
  createdAt DateTime @default(now())
}

model ProcessedWebhook {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model AuditLog {
  id               String   @id @default(cuid())
  action           String   // user.created, user.updated, etc
  adminId          String
  targetUserId     String?
  targetResourceId String?
  resourceType     String?  // user, plan, subscription, etc
  changes          Json?    // { before: {...}, after: {...} }
  metadata         Json?    // Additional context
  ipAddress        String?
  userAgent        String?
  timestamp        DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([timestamp])
  @@index([action])
}

model TesterInvite {
  id         String    @id @default(cuid())
  name       String
  phone      String?
  code       String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  clickCount Int       @default(0)
  usedAt     DateTime?
  usedBy     String?

  @@index([code])
}

model PrivacyPolicy {
  id        String   @id @default(cuid())
  version   String   @unique  // "1.0", "1.1", etc
  content   String   // HTML content
  createdAt DateTime @default(now())

  @@index([version])
}

model WebhookConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  url       String
  secret    String   // Chave HMAC-SHA256 para assinar payloads
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Admin features ────────────────────────────────────────────────────────────

// #6 — Histórico de uptime dos serviços (checker no worker, a cada 5 min)
model ServiceStatusLog {
  id        String   @id @default(cuid())
  service   String   // "api" | "db" | "redis" | "queue" | "whatsapp" | "groq" | "email"
  status    String   // "up" | "down" | "degraded"
  latencyMs Int?
  checkedAt DateTime @default(now())

  @@index([service, checkedAt])
}

// #10 — Respostas NPS dos usuários
model NpsResponse {
  id        String   @id @default(cuid())
  userId    String
  score     Int      // 0–10
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

// #4 — Configuração de alertas automáticos do admin
model AdminAlertConfig {
  id        String   @id @default(cuid())
  key       String   @unique  // "queueMaxWaiting" | "errorRatePct" | "alertPhone" | "alertEmail"
  value     Json
  updatedAt DateTime @updatedAt
}
