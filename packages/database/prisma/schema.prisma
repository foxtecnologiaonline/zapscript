generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                          String          @id @default(cuid())
  email                       String          @unique
  name                        String?
  document                    String?         @unique   // CPF ou CNPJ
  emailVerified               Boolean         @default(false)
  refCode                     String          @unique @default(cuid())
  referredBy                  String?
  isAdmin                     Boolean         @default(false)
  isTester                    Boolean         @default(false)
  testerSince                 DateTime?
  // LGPD - Direitos do usuário
  privacyPolicyAcceptedAt     DateTime?
  termsAcceptedAt             DateTime?
  deletedAt                   DateTime?       // Soft delete
  pseudonymizedAt             DateTime?       // LGPD: dados anonimizados
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  subscription                Subscription?
  balance                     MinuteBalance?
  numbers                     WhatsappNumber[]
  transcriptions              Transcription[]
  usageLogs                   UsageLog[]
  supportTickets              SupportTicket[]
}

model Plan {
  id              String         @id @default(cuid())
  name            String         @unique  // "free" | "pro" | "ultra"
  label           String
  minutesPerMonth Int
  maxNumbers      Int
  priceBrl        Float
  asaasProductId  String?  // Não usado — Asaas não pré-cria price IDs
  features        Json           @default("[]")
  createdAt       DateTime       @default(now())
  subscriptions   Subscription[]
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  planId               String
  asaasSubscriptionId String?
  asaasCustomerId     String?
  status               String    @default("active")
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 Plan      @relation(fields: [planId], references: [id])
}

model MinuteBalance {
  id                 String   @id @default(cuid())
  userId             String   @unique
  availableMinutes   Float    @default(0)
  accumulatedMinutes Float    @default(0)
  resetAt            DateTime
  lastAlertSent      String?  // "50" | "80" | "100" — para evitar alertas duplicados
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatsappNumber {
  id               String          @id @default(cuid())
  userId           String
  phoneNumber      String           @default("pending")
  displayName      String?
  sessionEncrypted String?
  status           String           @default("disconnected")
  connectedAt      DateTime?
  lastMessageAt    DateTime?
  messageCount     Int              @default(0)
  minutesUsed      Float            @default(0)
  zapiInstanceId   String?          // sem @unique — múltiplos usuários podem compartilhar a mesma instância Z-API
  zapiToken        String?          // Token da instância Z-API criada dinamicamente
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcriptions   Transcription[]
}

model Transcription {
  id              String          @id @default(cuid())
  userId          String
  numberId        String?
  contactPhone    String
  contactName     String?
  durationSec     Float
  originalText    String
  summaryBullets  Json
  confidenceScore Float?
  language        String          @default("pt")
  source          String          @default("whatsapp")  // "whatsapp" | "manual"
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  number          WhatsappNumber? @relation(fields: [numberId], references: [id], onDelete: SetNull)
  usageLog        UsageLog?
}

model UsageLog {
  id              String         @id @default(cuid())
  userId          String
  transcriptionId String?        @unique
  minutesUsed     Float
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcription   Transcription? @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)
}

model SupportTicket {
  id                  String   @id @default(cuid())
  userId              String?
  name                String
  email               String
  category            String
  description         String
  status              String   @default("open")
  attachmentData      String?  // Base64 encoded file
  attachmentFilename  String?
  attachmentMimeType  String?
  createdAt           DateTime @default(now())
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemError {
  id        String   @id @default(cuid())
  service   String
  message   String
  stack     String?
  context   Json?
  createdAt DateTime @default(now())
}

model ProcessedWebhook {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model AuditLog {
  id               String   @id @default(cuid())
  action           String   // user.created, user.updated, etc
  adminId          String
  targetUserId     String?
  targetResourceId String?
  resourceType     String?  // user, plan, subscription, etc
  changes          Json?    // { before: {...}, after: {...} }
  metadata         Json?    // Additional context
  ipAddress        String?
  userAgent        String?
  timestamp        DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([timestamp])
  @@index([action])
}

model TesterInvite {
  id         String    @id @default(cuid())
  name       String
  phone      String?
  code       String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  clickCount Int       @default(0)
  usedAt     DateTime?
  usedBy     String?

  @@index([code])
}

model PrivacyPolicy {
  id        String   @id @default(cuid())
  version   String   @unique  // "1.0", "1.1", etc
  content   String   // HTML content
  createdAt DateTime @default(now())

  @@index([version])
}
