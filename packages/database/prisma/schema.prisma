generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                @id @default(cuid())
  email                   String                @unique
  name                    String?
  phone                   String? // Celular de contato (opcional)
  document                String? // CPF/CNPJ (AES-256-GCM encrypted)
  documentHash            String?               @unique // HMAC-SHA256 blind index (busca de duplicata)
  emailVerified           Boolean               @default(false)
  refCode                 String                @unique @default(cuid())
  referredBy              String?
  isAdmin                 Boolean               @default(false)
  isTester                Boolean               @default(false)
  testerSince             DateTime?
  // LGPD - Consentimentos e direitos do usuário
  privacyPolicyAcceptedAt DateTime?
  termsAcceptedAt         DateTime?
  contractAcceptedAt      DateTime? // Contrato de Prestação de Serviços
  marketingConsentAt      DateTime? // Consentimento opcional de marketing
  consentDocVersion       String? // ex: "tos_v2.0,contrato_v2.0,pp_v2.0"
  deletedAt               DateTime? // Soft delete
  pseudonymizedAt         DateTime? // LGPD: dados anonimizados
  utmSource               String? // Atribuição de origem (primeiro toque) — ex: "google", "seo"
  utmCampaign             String? // ex: "corretores", "advogados"
  utmMedium               String? // ex: "cpc", "organic"
  lifecycleEmailsSent     String[]              @default([]) // tags de e-mails de ciclo de vida já enviados (idempotência)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  subscription            Subscription?
  balance                 MinuteBalance?
  numbers                 WhatsappNumber[]
  transcriptions          Transcription[]
  usageLogs               UsageLog[]
  supportTickets          SupportTicket[]
  webhookConfig           WebhookConfig?
  npsResponses            NpsResponse[]
  supportAtendimentos     SupportAtendimento[]
  affiliate               Affiliate?
  affiliateReferral       AffiliateReferral?    @relation("ReferredUser")
  proContactSeeds         ProContactSeed[]
  entitlements            Entitlement[]
  cobrancaClientes        CobrancaCliente[]
  cobrancaCobrancas       CobrancaCobranca[]
  cobrancaConfig          CobrancaConfig?
  campanhas               Campanha[]
  campanhaOptOuts         CampanhaOptOut[]
  crmStages               CrmStage[]
  crmContacts             CrmContact[]
  crmActivities           CrmActivity[]
  atendeConfigs           AtendeConfig[]
  atendeKnowledgeBase     AtendeKnowledgeBase[]
  atendeConversations     AtendeConversation[]
  voiceCommands           VoiceCommand[]
  salesVisits             SalesVisit[]
  legendaJobs             LegendaJob[]
  ownedTeams              Team[]              @relation("TeamOwner")
  teamMemberships         TeamMember[]
  apiKeys                 ApiKey[]
  avisos                  Aviso[]
  tasks                   Task[]              @relation("TaskOwner")
  assignedTasks           Task[]              @relation("TaskAssignee")
}

model Plan {
  id              String         @id @default(cuid())
  name            String         @unique // "free" | "pro" | "executive" | "profissional" | "empresas"
  label           String
  minutesPerMonth Int // [LEGADO] mantido só como métrica interna de custo
  audiosPerMonth  Int            @default(0) // Métrica primária de cota: nº de áudios/mês. FREE=15, PRO=500 (teto oculto)
  maxNumbers      Int
  priceBrl        Float
  features        Json           @default("[]")
  createdAt       DateTime       @default(now())
  subscriptions   Subscription[]
}

model Subscription {
  id                  String    @id @default(cuid())
  userId              String    @unique
  planId              String
  asaasSubscriptionId String? // Asaas subscription ID (sub_...)
  asaasCustomerId     String? // Asaas customer ID (cus_...)
  paymentMethod       String? // 'credit_card' | 'pix'
  status              String    @default("active") // 'trialing' | 'active' | 'past_due' | 'canceled'
  currentPeriodEnd    DateTime?
  // ── [LEGADO] Trial Freemium removido (ZapScript 2.0 é freemium direto,
  //    sem cartão/trial no cadastro). Campos órfãos — nada mais escreve ou
  //    lê estas duas colunas; mantidas só para não quebrar linhas antigas.
  //    Candidatas a remoção numa migração futura, após confirmar uso zero. ──
  trialEndsAt         DateTime?
  trialDowngradedAt   DateTime?
  testerRenewalsUsed  Int       @default(0) // Renovações mensais isentas consumidas (máx 12)
  comboDiscountPct    Float? // % fixo (ex.: 0.20) aplicado sobre o valor agregado — setado ao contratar o Combo (Core+módulos)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                Plan      @relation(fields: [planId], references: [id])
}

model MinuteBalance {
  id                 String    @id @default(cuid())
  userId             String    @unique
  availableMinutes   Float     @default(0)
  accumulatedMinutes Float     @default(0)
  extraMinutes       Float     @default(0) // minutos avulsos/indicação — valem 60 dias, não resetam mensalmente
  extraExpiresAt     DateTime? // expiração do saldo extra (now + 60 dias na última recarga)
  audiosUsed         Int       @default(0) // Métrica primária: nº de áudios consumidos no ciclo atual (reset mensal)
  resetAt            DateTime
  lastAlertSent      String? // "50" | "80" | "100" — para evitar alertas duplicados
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhatsappNumber {
  id                  String               @id @default(cuid())
  userId              String
  phoneNumber         String               @default("pending")
  displayName         String?
  sessionEncrypted    String?
  status              String               @default("disconnected")
  connectedAt         DateTime?
  lastMessageAt       DateTime?
  messageCount        Int                  @default(0)
  minutesUsed         Float                @default(0)
  zapiInstanceId      String? // sem @unique — múltiplos usuários podem compartilhar a mesma instância Z-API
  zapiToken           String? // Token da instância Z-API criada dinamicamente
  privateMode         Boolean              @default(false) // Modo Privado: ativado manualmente pelo usuário (opt-in). Quando true, resumo vai só ao próprio número.
  isPublic            Boolean              @default(false) // Número público do ZapScript: qualquer pessoa pode encaminhar áudio e receber demo grátis. Sem custo contra quota de usuário.
  // ── Conexão via API oficial da Meta (WhatsApp Cloud API / Embedded Signup) ──
  // Usado apenas para o fluxo de App Review da Meta. Usuários reais seguem no Evolution.
  provider            String               @default("evolution") // 'evolution' | 'meta'
  metaWabaId          String? // WhatsApp Business Account ID
  metaPhoneNumberId   String? // Phone Number ID (Cloud API)
  metaBusinessId      String? // Business Manager ID
  metaAccessTokenEnc  String? // Token de acesso AES-256-GCM (encryptStr)
  metaTokenExpiresAt  DateTime? // Expiração do token (se aplicável)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcriptions      Transcription[]
  atendeConfig        AtendeConfig?
  atendeConversations AtendeConversation[]
  crmContacts         CrmContact[]
  campanhas           Campanha[]
  avisos              Aviso[]

  @@index([userId]) // A2: listagem de números por usuário
  @@index([zapiInstanceId]) // A2: busca de instância em webhook (hot path)
}

model Transcription {
  id              String          @id @default(cuid())
  userId          String
  numberId        String?
  contactPhone    String
  contactName     String?
  filename        String? // Nome original do arquivo (uploads manuais)
  durationSec     Float
  originalText    String
  summaryBullets  Json
  confidenceScore Float?
  language        String          @default("pt")
  source          String          @default("whatsapp") // "whatsapp" | "manual"
  tags            String[]        @default([]) // Tags do usuário (Ultra+)
  footerShown     Boolean         @default(false) // se o rodapé viral foi exibido nesta conversão
  footerVariant   String? // qual variação do rodapé foi usada (B1 — análise de conversão por variação)
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  number          WhatsappNumber? @relation(fields: [numberId], references: [id], onDelete: SetNull)
  usageLog        UsageLog?

  @@index([userId]) // A2: listagem por usuário (hot path em toda API)
  @@index([userId, createdAt(sort: Desc)]) // A2: ordenação padrão date_desc
}

model UsageLog {
  id              String         @id @default(cuid())
  userId          String
  transcriptionId String?        @unique
  minutesUsed     Float
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transcription   Transcription? @relation(fields: [transcriptionId], references: [id], onDelete: SetNull)

  @@index([userId]) // A2: aggregations de uso por usuário
  @@index([createdAt]) // A2: relatórios e agregações por período
}

model SupportTicket {
  id                 String   @id @default(cuid())
  userId             String?
  name               String
  email              String
  category           String
  description        String
  status             String   @default("open")
  attachmentUrl      String? // Supabase Storage URL (novo)
  attachmentData     String? // Base64 legado (manter para registros antigos)
  attachmentFilename String?
  attachmentMimeType String?
  createdAt          DateTime @default(now())
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemError {
  id        String   @id @default(cuid())
  service   String
  message   String
  stack     String?
  context   Json?
  createdAt DateTime @default(now())
}

model ProcessedWebhook {
  id          String   @id @default(cuid())
  paymentId   String   @unique
  processedAt DateTime @default(now())

  @@index([processedAt])
}

model AuditLog {
  id               String   @id @default(cuid())
  action           String // user.created, user.updated, etc
  adminId          String
  targetUserId     String?
  targetResourceId String?
  resourceType     String? // user, plan, subscription, etc
  changes          Json? // { before: {...}, after: {...} }
  metadata         Json? // Additional context
  ipAddress        String?
  userAgent        String?
  timestamp        DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([timestamp])
  @@index([action])
}

model TesterInvite {
  id         String    @id @default(cuid())
  name       String
  phone      String?
  code       String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  clickCount Int       @default(0)
  usedAt     DateTime?
  usedBy     String?

  @@index([code])
}

model PrivacyPolicy {
  id        String   @id @default(cuid())
  version   String   @unique // "1.0", "1.1", etc
  content   String // HTML content
  createdAt DateTime @default(now())

  @@index([version])
}

model WebhookConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  url       String
  secret    String // Chave HMAC-SHA256 para assinar payloads
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Admin features ────────────────────────────────────────────────────────────

// #6 — Histórico de uptime dos serviços (checker no worker, a cada 5 min)
model ServiceStatusLog {
  id        String   @id @default(cuid())
  service   String // "api" | "db" | "redis" | "queue" | "whatsapp" | "groq" | "email"
  status    String // "up" | "down" | "degraded"
  latencyMs Int?
  checkedAt DateTime @default(now())

  @@index([service, checkedAt])
}

// #10 — Respostas NPS dos usuários
model NpsResponse {
  id        String   @id @default(cuid())
  userId    String
  score     Int // 0–10
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

// #4 — Configuração de alertas automáticos do admin
model AdminAlertConfig {
  id        String   @id @default(cuid())
  key       String   @unique // "queueMaxWaiting" | "errorRatePct" | "alertPhone" | "alertEmail"
  value     Json
  updatedAt DateTime @updatedAt
}

// ── Agente de Suporte Inteligente ──────────────────────────────────────────
// Cada atendimento = uma mensagem recebida + classificação + rascunho do agente,
// aguardando aprovação humana antes de enviar pelo canal de origem.
model SupportAtendimento {
  id                String   @id @default(cuid())
  canal             String // 'whatsapp' | 'email' | 'chat'
  status            String   @default("pending_approval") // pending_approval | sent | escalated | spam | resolved
  categoria         String? // duvida_produto | problema_tecnico | reclamacao | cancelamento | upgrade_plano | cobranca | elogio | spam | outro
  prioridade        String? // baixa | media | alta | urgente
  sentimento        String? // positivo | neutro | negativo | frustrado
  confiancaResposta Int? // 0–100
  requerEscalacao   Boolean  @default(false)
  topicos           String[] @default([])

  clienteNome     String?
  clienteEmail    String?
  clienteWhatsapp String?
  clienteUserId   String?

  mensagemOriginal String
  rascunhoAgente   String?
  respostaFinal    String?
  editadoPeloAdmin Boolean @default(false)
  instrucaoRevisao String?

  threadId       String? // agrupa a conversa (canal + remetente)
  canalExternoId String? // messageId externo (WhatsApp/email) — idempotência
  contextoUsado  String? // títulos/ids da base de conhecimento usados no rascunho
  sugestaoFaq    String? // título de novo tópico FAQ sugerido pelo agente

  criadoEm    DateTime  @default(now())
  aprovadoEm  DateTime?
  enviadoEm   DateTime?
  resolvidoEm DateTime?

  user User? @relation(fields: [clienteUserId], references: [id], onDelete: SetNull)

  @@index([status, prioridade])
  @@index([canal, criadoEm])
  @@index([threadId])
  @@index([canalExternoId])
}

// Base de conhecimento (RAG). MVP: busca por palavra-chave. `embedding` (pgvector)
// fica reservado para evolução — coluna criada como texto nulo até habilitar pgvector.
model KnowledgeBase {
  id                  String   @id @default(cuid())
  titulo              String
  conteudo            String
  categoria           String?
  tags                String[] @default([])
  canalOrigem         String? // de qual atendimento/canal surgiu
  atendimentoOrigemId String?
  aprovadoPorAdmin    Boolean  @default(true)
  vezesUtilizado      Int      @default(0)
  utilidadeMedia      Float    @default(0)
  criadoEm            DateTime @default(now())
  atualizadoEm        DateTime @updatedAt

  @@index([categoria])
}

// ── Programa de Afiliados ───────────────────────────────────────────────────
// Afiliado = usuário aprovado que divulga o ZapScript e ganha comissão por venda.
// Decisões: cadastro requer aprovação do admin; comissão é recorrente — 30% em
// cada pagamento do indicado nos primeiros 12 meses (40% se o afiliado bateu a
// meta de 50+ clientes novos no mês da conversão), depois 5% residual vitalício.
// Cancelamento nos primeiros 30 dias zera a comissão pendente (ver lib/affiliate.ts).
// Pagamento = rastreado no sistema e quitado manualmente via Pix pelo admin.
model Affiliate {
  id                String                @id @default(cuid())
  userId            String                @unique
  code              String                @unique // código de divulgação (?ref=CODE)
  status            String                @default("pending") // pending | approved | rejected | suspended
  pixKey            String? // chave Pix p/ recebimento (não é segredo financeiro crítico)
  pixKeyType        String? // cpf | cnpj | email | phone | random
  payoutName        String? // nome/razão social do recebedor
  audience          String? // como pretende divulgar (texto do cadastro)
  notes             String? // observações internas do admin
  rejectedReason    String?
  appliedAt         DateTime              @default(now())
  approvedAt        DateTime?
  approvedBy        String? // adminId que aprovou
  payoutRequestedAt DateTime? // última solicitação de saque do afiliado
  customRate        Float? // override individual da taxa base (fração, ex.: 0.35) — vazio usa a taxa global
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals         AffiliateReferral[]
  commissions       AffiliateCommission[]
  clicks            AffiliateClick[]

  @@index([status])
  @@index([code])
}

// Vínculo afiliado → usuário indicado (criado no cadastro do indicado).
model AffiliateReferral {
  id             String    @id @default(cuid())
  affiliateId    String
  referredUserId String    @unique // cada usuário é indicado por no máximo 1 afiliado
  status         String    @default("pending") // pending (cadastrou) | converted (já gerou venda)
  convertedAt    DateTime?
  bonusTier      Boolean   @default(false) // travado na conversão: era o cliente novo nº51+ do afiliado no mês? (30%→40% enquanto recorrente)
  createdAt      DateTime  @default(now())
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser   User      @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

// Comissão devida por uma venda atribuída ao afiliado.
model AffiliateCommission {
  id               String    @id @default(cuid())
  affiliateId      String
  referredUserId   String
  paymentId        String // Asaas payment id (idempotência)
  saleAmount       Float // valor da venda (mensalidade paga)
  commissionAmount Float // valor da comissão devida
  commissionType   String // 'monthly' | 'annual' — plano do pagamento que gerou a comissão
  monthIndex       Int       @default(1) // recorrente: nº do pagamento do indicado (1, 2, 3...) — define a janela de 12 meses
  status           String    @default("pending") // pending | paid | canceled (cancelada = churn nos primeiros 30 dias)
  paidAt           DateTime?
  paidReference    String? // comprovante/observação do Pix manual
  createdAt        DateTime  @default(now())
  affiliate        Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@unique([paymentId, affiliateId])
  @@index([affiliateId, status])
}

// Tracking de cliques em links de afiliado.
// Registro anônimo: IP hasheado (SHA-256) para LGPD, sem PII.
model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  code        String
  ip          String?   // SHA-256 do IP (anonimizado)
  userAgent   String?
  referrer    String?
  country     String?
  converted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@index([code, createdAt])
}

// Configuração do Programa de Afiliados editável pelo admin sem redeploy.
// Padrão key/value/Json (mesma ideia do AdminAlertConfig) — chaves conhecidas:
// "rates" | "autoApprove" | "reportSchedule". Ausência de linha = usa o default
// hardcoded em lib/affiliate.ts (COMMISSION) ou desligado, conforme a chave.
model AffiliateConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// Campanha sazonal de bônus (ex.: "Black Friday: 50% de 20/11 a 30/11").
// Enquanto ativa e dentro da janela, sua taxa substitui base/bônus/personalizada
// na atribuição de novas comissões (ver lib/affiliate.ts). Não afeta a taxa
// residual (pós 12 meses).
model AffiliateCampaign {
  id        String   @id @default(cuid())
  name      String
  rate      Float // fração, ex.: 0.5 = 50%
  startsAt  DateTime
  endsAt    DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active, startsAt, endsAt])
}

// Leads capturados pela demo pública da landing page ("transcreva 1 áudio grátis").
model DemoLead {
  id          String   @id @default(cuid())
  email       String
  ip          String?
  durationSec Float?
  createdAt   DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// Analytics first-party — visitas e cliques de CTA do site público.
// Anônimo: visitorId é um id aleatório do navegador (não-PII); IP não é
// armazenado, só geo grosseira (país/região/cidade) vinda dos headers da Vercel.
model SiteEvent {
  id          String   @id @default(cuid())
  type        String // 'pageview' | 'click'
  path        String // caminho da página
  name        String? // clique: nome do CTA
  visitorId   String? // id anônimo do navegador (não-PII)
  referrer    String?
  device      String? // 'mobile' | 'desktop'
  country     String?
  region      String?
  city        String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([path])
  @@index([country])
  @@index([visitorId])
}

// ── Rodapé condicional (Modo Privado PRO) ──────────────────────────────────
// Registra que o usuário PRO já "semeou" o rodapé viral para um contato.
// Regra: FREE → rodapé em toda transcrição. PRO → rodapé apenas na 1ª transcrição
// de cada contato; nas demais, Modo Privado (sem rodapé). O seed é PERMANENTE
// (nunca reseta), mesmo que o usuário oscile entre planos.
// contactId = telefone normalizado (somente dígitos) de quem ENVIOU o áudio.
model ProContactSeed {
  id            String   @id @default(cuid())
  userId        String
  contactId     String // telefone do remetente, normalizado (digits-only)
  footerVariant String? // variação de rodapé usada na 1ª exibição (B1)
  firstSeenAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
  @@index([userId])
}

// Sugestões de novos tópicos de FAQ detectados pelo agente.
model FaqSuggestion {
  id                  String    @id @default(cuid())
  tituloSugerido      String
  conteudoSugerido    String
  categoria           String?
  atendimentoOrigemId String?
  status              String    @default("pending") // pending | approved | ignored
  criadoEm            DateTime  @default(now())
  revisadoEm          DateTime?

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Suíte de módulos — catálogo + titularidade (ver MODULOS_ARQUITETURA.md)
// Product espelha packages/modules/catalog.ts (semeado pelo seed).
// Entitlement é a fonte da verdade de acesso, independente do tier (Plan) do core.
// ─────────────────────────────────────────────────────────────────────────────
model Product {
  id           String        @id @default(cuid())
  key          String        @unique // 'core' | 'cobranca' | ... (== catalog.ts)
  name         String
  status       String        @default("planned") // 'ga' | 'beta' | 'planned' | 'discovery'
  priceMonthly Float         @default(0)
  priceYearly  Float         @default(0)
  dependsOn    String[]      @default([]) // keys de módulos requeridos (dependência dura)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  entitlements Entitlement[]
}

model Entitlement {
  id               String    @id @default(cuid())
  userId           String
  productKey       String // FK -> Product.key
  status           String    @default("active") // 'active'|'trialing'|'past_due'|'canceled'|'pending' (pending = PIX aguardando confirmação; não concede acesso)
  source           String    @default("paid") // 'paid'|'trial'|'comp'|'bundle'|'affiliate'
  currentPeriodEnd DateTime?
  canceledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productKey], references: [key], onDelete: Cascade)

  @@unique([userId, productKey])
  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Módulo Cobrança — lembretes automáticos de vencimento via WhatsApp.
// Não é gateway de pagamento: o usuário registra cliente + valor + vencimento,
// e o worker envia lembrete (dia do vencimento + 1º dia de atraso) usando a
// própria instância WhatsApp conectada do usuário. Reenvio manual a qualquer momento.
// ─────────────────────────────────────────────────────────────────────────────
model CobrancaCliente {
  id        String             @id @default(cuid())
  userId    String
  nome      String
  telefone  String // DDI+DDD+número, só dígitos (ex: 5511999999999)
  documento String? // CPF/CNPJ (opcional)
  email     String?
  notas     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime? // soft delete (LGPD)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cobrancas CobrancaCobranca[]

  @@index([userId, deletedAt])
}

model CobrancaCobranca {
  id               String          @id @default(cuid())
  userId           String
  clienteId        String
  descricao        String
  valor            Float
  vencimento       DateTime // data do vencimento (meia-noite UTC do dia)
  status           String          @default("pendente") // 'pendente' | 'paga' | 'cancelada'
  pagoEm           DateTime?
  recorrente       Boolean         @default(false) // #5: gera a próxima ocorrência automaticamente ao marcar paga
  recorrenciaMeses Int? // intervalo em meses (1=mensal, 12=anual etc.)
  origemVoz        Boolean         @default(false) // #1: criada via comando de voz (self-note)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cliente          CobrancaCliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  envios           CobrancaEnvio[]

  @@index([userId, status, vencimento])
  @@index([clienteId])
}

model CobrancaEnvio {
  id         String           @id @default(cuid())
  cobrancaId String
  tipo       String // 'vence_hoje' | 'venceu' | 'manual' | 'd+N' | 'd-N'
  enviadoEm  DateTime         @default(now())
  sucesso    Boolean          @default(true)
  erro       String?
  cobranca   CobrancaCobranca @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)

  @@index([cobrancaId, tipo])
}

// CobrancaConfig: preferências do dono (tom de mensagem, régua de lembretes,
// chave PIX, resumo diário). 1:1 com User; criada com defaults no 1º acesso.
model CobrancaConfig {
  id             String   @id @default(cuid())
  userId         String   @unique
  tom            String   @default("cordial") // 'cordial' | 'formal' | 'direto'
  escalarTom     Boolean  @default(true) // #10: endurece o tom conforme o atraso aumenta
  diasAntes      Int[]    @default([1]) // #4: lembra X dias antes do vencimento
  diasDepois     Int[]    @default([1, 3, 7]) // #4: cobra de novo X dias após vencer
  pixKey         String? // #9: incluída nas mensagens de lembrete
  pixKeyType     String? // 'cpf' | 'cnpj' | 'email' | 'telefone' | 'aleatoria'
  resumoDiario   Boolean  @default(false) // #8
  resumoHora     Int      @default(8) // hora local (BRT) do resumo diário
  onboardingDone Boolean  @default(false) // #2
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────────────────────
// ZapScript Campanhas — disparo em massa via WhatsApp API oficial (Meta Cloud API).
// Exige template pré-aprovado pela Meta (mensagem fora da janela de 24h de sessão).
// ─────────────────────────────────────────────────────────────────────────────
model Campanha {
  id                 String            @id @default(cuid())
  userId             String
  whatsappNumberId   String
  name               String
  status             String            @default("draft") // draft|scheduled|running|paused|completed|canceled|failed
  templateName       String
  templateLanguage   String            @default("pt_BR")
  templateComponents Json? // estrutura de componentes do template (header/body/botões) usada no envio
  audienceCount      Int               @default(0)
  sentCount          Int               @default(0) // contador incremental — único escritor é o worker (evita drift)
  scheduledAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  whatsappNumber     WhatsappNumber    @relation(fields: [whatsappNumberId], references: [id], onDelete: Cascade)
  contatos           CampanhaContato[]

  @@index([userId])
  @@index([whatsappNumberId])
  @@index([status])
}

model CampanhaContato {
  id           String    @id @default(cuid())
  campanhaId   String
  phone        String
  name         String?
  variables    Json? // valores das variáveis do template para este contato ({{1}}, {{2}}, ...)
  status       String    @default("pending") // pending|sent|delivered|read|failed|optout
  wamid        String? // message id da Meta — correlaciona com o status recebido no webhook
  errorMessage String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  failedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  campanha     Campanha  @relation(fields: [campanhaId], references: [id], onDelete: Cascade)

  @@index([campanhaId])
  @@index([campanhaId, status])
  @@index([wamid]) // correlação de status recebido no webhook (hot path)
}

model CampanhaOptOut {
  id        String   @id @default(cuid())
  userId    String // dono do número Business — opt-out é por conta, não global
  phone     String
  reason    String? // palavra-chave detectada (ex: "PARAR")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Módulo CRM — funil de vendas dentro do WhatsApp (ver MODULOS_ARQUITETURA.md).
// v1 é gerenciado manualmente: usuário arrasta contatos entre estágios e pode
// importar contatos já existentes no histórico de Transcription (1 clique).
// Escopo v1 NÃO altera o webhook de mensageria — nenhuma captura automática.
// ─────────────────────────────────────────────────────────────────────────────

// Estágio do funil (colunas do Kanban). Semeado com 5 padrões no primeiro
// acesso do usuário ao módulo (Novo lead, Contato feito, Negociando, Fechado, Perdido).
model CrmStage {
  id        String       @id @default(cuid())
  userId    String
  name      String
  order     Int          @default(0)
  color     String       @default("#6b7280") // hex — cor do cabeçalho da coluna
  isWon     Boolean      @default(false) // estágio terminal de sucesso (fecha o deal)
  isLost    Boolean      @default(false) // estágio terminal de perda
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts  CrmContact[]

  @@index([userId, order])
}

// Um lead/contato dentro do funil. phone é único por usuário (evita duplicar
// o mesmo contato ao importar do histórico de transcrições mais de uma vez).
model CrmContact {
  id             String          @id @default(cuid())
  userId         String
  stageId        String
  name           String
  phone          String
  email          String?
  company        String?
  value          Float? // valor estimado do negócio (R$)
  tags           String[]        @default([])
  numberId       String? // WhatsappNumber de origem, quando importado
  source         String          @default("manual") // 'manual' | 'import_whatsapp'
  lostReason     String?
  lastActivityAt DateTime        @default(now())
  closedAt       DateTime? // preenchido quando entra em estágio isWon/isLost
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage          CrmStage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  number         WhatsappNumber? @relation(fields: [numberId], references: [id], onDelete: SetNull)
  activities     CrmActivity[]

  @@unique([userId, phone])
  @@index([userId, stageId])
  @@index([userId, lastActivityAt(sort: Desc)])
}

// Linha do tempo do contato: notas manuais, mudanças de estágio (log
// automático) e lembretes (dueAt + completedAt).
model CrmActivity {
  id          String     @id @default(cuid())
  contactId   String
  userId      String
  type        String // 'note' | 'stage_change' | 'call' | 'meeting' | 'reminder' | 'whatsapp'
  content     String
  dueAt       DateTime? // lembretes: quando vence
  completedAt DateTime? // lembretes: quando foi concluído
  createdAt   DateTime   @default(now())
  contact     CrmContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt(sort: Desc)])
  @@index([userId, dueAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// ZapScript Atende — resposta automática por IA sobre um número já conectado.
// Tenant-scoped (userId em todos os modelos), ao contrário do motor de suporte
// interno da FOX (SupportAtendimento/KnowledgeBase, que é single-tenant).
// ─────────────────────────────────────────────────────────────────────────────
model AtendeConfig {
  id              String         @id @default(cuid())
  numberId        String         @unique
  userId          String
  enabled         Boolean        @default(false)
  businessContext String? // descrição livre do negócio, usada no prompt do agente
  tone            String         @default("profissional-amigavel")
  fallbackMessage String         @default("Recebemos sua mensagem! Já já alguém te responde por aqui.")
  escalationPhone String? // opcional: número interno avisado quando escala p/ humano
  confidenceLevel String         @default("equilibrado") // 'conservador' | 'equilibrado' | 'autonomo' — mapeado p/ threshold em atende-agent.ts
  digestFrequency String         @default("off") // 'off' | 'daily' | 'weekly' — opt-in, resumo periódico ao dono
  lastDigestAt    DateTime? // controle de idempotência do digest (delta de tempo, não calendário) — ver runAtendeDigests em apps/worker
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  number          WhatsappNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AtendeKnowledgeBase {
  id        String   @id @default(cuid())
  userId    String
  question  String
  answer    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model AtendeConversation {
  id            String          @id @default(cuid())
  userId        String
  numberId      String
  contactPhone  String
  contactName   String?
  status        String          @default("open") // 'open' | 'escalated' | 'closed'
  humanTakeover Boolean         @default(false) // true = resposta automática desligada nesta conversa
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  number        WhatsappNumber  @relation(fields: [numberId], references: [id], onDelete: Cascade)
  messages      AtendeMessage[]

  @@unique([numberId, contactPhone])
  @@index([userId, lastMessageAt(sort: Desc)])
}

model AtendeMessage {
  id             String             @id @default(cuid())
  conversationId String
  direction      String // 'in' | 'out'
  content        String
  aiGenerated    Boolean            @default(false)
  humanAuthored  Boolean            @default(false) // true = capturado do fromMe real do dono (takeover), não é o fallback do bot
  confidence     Float?
  createdAt      DateTime           @default(now())
  conversation   AtendeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Comando de Voz Universal — um áudio que o usuário manda pro próprio número
// (self-note) é interpretado também como comando, além de transcrito normal.
// Este modelo é o log de auditoria de toda ação automática tomada em nome do
// usuário (LGPD: usuário pode ver o que a IA executou sozinha, sem intervenção
// humana). Não tem relação direta com Transcription para não acoplar módulos —
// transcriptionId é apenas uma referência solta para depuração/correlação.
// ─────────────────────────────────────────────────────────────────────────────
model VoiceCommand {
  id              String   @id @default(cuid())
  userId          String
  numberId        String?
  transcriptionId String?
  rawText         String
  intent          String // 'crm_create_lead' | 'crm_query' | 'atende_add_kb' | 'stats_query' | 'none'
  status          String   @default("detected") // 'detected' | 'executed' | 'failed' | 'ignored'
  resultSummary   String? // texto enviado de volta ao usuário (confirmação/resposta)
  confidence      Float?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ── Módulo Vendas ──────────────────────────────────────────────────────────
// Visita/ligação comercial gravada pelo vendedor → transcrita e resumida
// (foco em valores, objeções, combinados e próximo passo). Sem retenção de
// áudio (deletado após processar) e sem consumo do MinuteBalance do Core —
// gate é o entitlement do módulo (Product/Entitlement, key "vendas").
model SalesVisit {
  id             String   @id @default(cuid())
  userId         String
  clientName     String? // Nome do cliente/prospect (texto livre, não criptografado — como Transcription.contactName)
  filename       String? // Nome original do arquivo de áudio enviado
  status         String   @default("processing") // 'processing' | 'done' | 'error'
  durationSec    Float    @default(0)
  originalText   String? // Transcrição (AES-256-GCM — encryptStr)
  summaryBullets Json? // Resumo em bullets (AES-256-GCM — encryptArr)
  errorMessage   String? // Motivo da falha quando status = 'error'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// Módulo Legendas — legenda automática para Reels/Stories.
// Vídeo enviado pelo usuário → áudio extraído → Whisper (com timestamps por
// segmento, reaproveitado da transcrição) → .srt/.vtt para download. MVP não
// inclui legenda queimada no vídeo (v2) nem canal WhatsApp (só upload web).
// ─────────────────────────────────────────────────────────────────────────────
model LegendaJob {
  id               String    @id @default(cuid())
  userId           String
  status           String    @default("pending") // pending | processing | done | error
  originalFilename String?
  inputStorageKey  String // bucket legenda-uploads
  inputSizeBytes   Int?
  durationSec      Float?
  language         String    @default("pt")
  srtStorageKey    String? // bucket legenda-output
  vttStorageKey    String?
  errorMessage     String?
  deletedAt        DateTime? // Soft delete
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Plano Empresas Multi-Seat — MVP
// Um dono de time paga por todos os seats (Pro cada membro). Cada membro
// herda o tier do dono. Sem RBAC complexo no MVP — só owner e member.
// ─────────────────────────────────────────────────────────────────────────────
model Team {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  ownerId   String
  owner     User         @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([ownerId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member") // 'owner' | 'member'
  status   String   @default("active") // 'invited' | 'active' | 'inactive'
  inviteCode String? @unique // código para aceitar convite (hash simples)
  invitedEmail String? // e-mail do convidado (antes de criar conta)
  joinedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([teamId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// API pública ZapScript 2.0 (tier Empresas) — chaves para integrar com Zapier,
// Make etc. Só o DONO do tier Empresas cria chaves (nunca membro de time — ver
// lib/teamScope.ts). O valor real da chave é mostrado 1x na criação; só o hash
// (SHA-256) fica no banco.
// ─────────────────────────────────────────────────────────────────────────────
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String // rótulo livre escolhido pelo dono (ex.: "Zapier")
  keyHash    String    @unique // SHA-256 do token real
  keyPrefix  String // primeiros caracteres do token, só para exibição/identificação
  scopes     String[]  @default([]) // 'conversations:read' | 'contacts:read'
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Avisos (tier Profissional) — o dono dispara manualmente uma mensagem pra um
// contato do WhatsApp (ex.: "pagamento hoje", "mercadoria pronta pra retirada").
// Diferente de Cobrança (retirado de venda): sem régua automática/agendada,
// é 1 envio manual por vez, com categoria fixa pra organizar o histórico.
// ─────────────────────────────────────────────────────────────────────────────
model Aviso {
  id           String         @id @default(cuid())
  userId       String
  numberId     String
  contactPhone String
  contactName  String?
  category     String // 'cobranca' | 'agendamento' | 'mercadoria_pronta' | 'outro'
  message      String
  createdAt    DateTime       @default(now())
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  number       WhatsappNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tarefas (tier Empresas) — designação e controle de tarefas dentro do time.
// userId = dono do time (mesmo padrão de teamScope.ownerId); assignedToId
// aponta pro userId do membro responsável (qualquer papel do time).
// ─────────────────────────────────────────────────────────────────────────────
model Task {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String?
  assignedToId String?
  status       String    @default("pending") // 'pending' | 'done'
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("TaskOwner", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo   User?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, dueAt])
}
