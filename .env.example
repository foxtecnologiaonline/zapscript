# ─────────────────────────────────────────────────────────
#  ZAPSCRIPT.ME — Environment Variables
#  Copie para .env e preencha antes de iniciar o projeto
# ─────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# ── SUPABASE (banco PostgreSQL) ───────────────────────────
# supabase.com → Settings → Database → Connection String (Transaction mode)
DATABASE_URL=postgresql://postgres.REF:SENHA@aws-1-us-west-2.pooler.supabase.com:6543/postgres
# supabase.com → Settings → Database → Connection String (Direct mode — para migrations)
DIRECT_URL=postgresql://postgres.REF:SENHA@aws-1-us-west-2.pooler.supabase.com:5432/postgres
# supabase.com → Settings → API
SUPABASE_URL=https://REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── REDIS (Upstash) ───────────────────────────────────────
# upstash.com → Redis → Connect → .env
REDIS_URL=redis://default:SENHA@HOST.upstash.io:6379

# ── OpenAI (Whisper) ──────────────────────────────────────
# platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ── Anthropic (Claude) ────────────────────────────────────
# console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ── WhatsApp Cloud API (Meta) ──────────────────────────────
# developers.facebook.com → App → WhatsApp
# Gere access token com escopo: whatsapp_business_messaging
WHATSAPP_API_TOKEN=EAAS...TOKEN_AQUI
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_WEBHOOK_TOKEN=GERE_UM_TOKEN_ALEATORIO_PARA_WEBHOOK
# App Secret do painel Meta Developers → App → Configurações → App Secret
# Obrigatório para validação HMAC dos webhooks em produção
WHATSAPP_APP_SECRET=SEU_APP_SECRET_META

# Resposta automática para mensagens de texto (true/false)
# Se true, responde "Envie um áudio..." quando usuário manda texto
# Deixe false em produção para não responder a todos automaticamente
WHATSAPP_AUTO_REPLY=false

# ── WhatsApp oficial multi-tenant (Embedded Signup / Tech Provider) ──────
# Onboarding dos clientes pela API oficial da Meta, cada um com sua própria WABA.
# META_APP_ID / META_APP_SECRET: painel Meta Developers → App → Configurações → Básico
#   (se ausentes, caem para WHATSAPP_APP_ID / WHATSAPP_APP_SECRET legados)
META_APP_ID=123456789012345
META_APP_SECRET=SEU_APP_SECRET_META
# Token do System User (Tech Provider) com escopos whatsapp_business_management + _messaging
# Usado para assinar WABAs dos clientes e operar números. Cai para WHATSAPP_API_TOKEN se ausente.
META_SYSTEM_USER_TOKEN=EAAS...SYSTEM_USER_TOKEN
# Token de verificação do webhook (cai para WHATSAPP_WEBHOOK_TOKEN se ausente)
META_WEBHOOK_VERIFY_TOKEN=GERE_UM_TOKEN_ALEATORIO_PARA_WEBHOOK
# PIN padrão de registro do número na Cloud API (6 dígitos) — usado se a 2FA estiver desativada
META_DEFAULT_REGISTER_PIN=000000
# Frontend (Next.js) — Embedded Signup. Sem estes, o botão "Conectar oficial" não aparece.
NEXT_PUBLIC_META_APP_ID=123456789012345
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=123456789012345

# ── Evolution API (WhatsApp self-hosted) ─────────────────
# Railway/VPS rodando EvolutionAPI/evolution-api
# EVOLUTION_API_URL: URL pública do servidor Evolution
# EVOLUTION_API_KEY: Railway → projeto Evolution → Variables → AUTHENTICATION_API_KEY
# EVOLUTION_WEBHOOK_SECRET: token aleatório (ex: openssl rand -hex 32) para segurança do webhook
EVOLUTION_API_URL=https://evolution-api-production-xxxx.up.railway.app
EVOLUTION_API_KEY=sua-chave-global-evolution
EVOLUTION_WEBHOOK_SECRET=GERE_COM_OPENSSL_RAND_HEX_32

# URL pública desta API (usada para construir a URL do webhook enviada ao Evolution)
API_URL=https://zapscript.onrender.com

# ── ASAAS (pagamentos) ────────────────────────────────────
# app.asaas.com → Configurações → Integrações → API Key
# Sandbox: sandbox.asaas.com — use $aact_... para sandbox
# Produção: app.asaas.com  — use $aact_... para produção
ASAAS_API_KEY=$aact_...

# Configurações → Notificações → Webhooks → URL + Token
# URL: https://zapscript-api.railway.app/billing/webhook
ASAAS_WEBHOOK_TOKEN=GERE_UM_TOKEN_ALEATORIO_AQUI

# ── Tokens Internos ───────────────────────────────────────
# Gerar com: node infra/gen-secrets.js
JWT_SECRET=GERE_COM_CRYPTO_RANDOMBYTES_48_HEX
ENCRYPTION_KEY=GERE_COM_CRYPTO_RANDOMBYTES_32_HEX_64CHARS
INTERNAL_TOKEN=GERE_COM_CRYPTO_RANDOMBYTES_32_HEX
MONITOR_TOKEN=GERE_COM_CRYPTO_RANDOMBYTES_32_HEX
ADMIN_TOKEN=GERE_COM_CRYPTO_RANDOMBYTES_32_HEX

# ── App ───────────────────────────────────────────────────
APP_URL=https://zapscript.me/
APP_NAME=ZapScript
NEXT_PUBLIC_API_URL=https://zapscript.me/
NEXT_PUBLIC_SUPABASE_URL=https://REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_APP_NAME=ZapScript

# ── E-mail (suporte + alertas) ────────────────────────────
# OPÇÃO 1 (RECOMENDADO para produção/cloud): Resend API — https://resend.com
# Nunca bloqueado por cloud providers (usa HTTPS porta 443)
# Grátis: 3.000 e-mails/mês | resend.com → API Keys → Create API Key
RESEND_API_KEY=re_...

# SMTP_FROM deve ser um domínio verificado no Resend (ex: ativacao@zapscript.me)
SMTP_FROM=ZapScript <ativacao@zapscript.me>
SUPPORT_EMAIL=suporte@zapscript.me

# OPÇÃO 2 (fallback local): SMTP direto — funciona apenas fora de cloud
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ativacao@zapscript.me
# SMTP_PASS=SUA_SENHA

# ── Monitor ───────────────────────────────────────────────
API_HEALTH_URL=https://zapscript-api.railway.app/health
DASHBOARD_URL=https://zapscript.me/dashboard
ALERT_EMAIL=contato@zapscript.me

# ── Sentry (error tracking) ───────────────────────────────
# sentry.io → Create Project → Copy DSN
SENTRY_DSN=https://SEU_KEY@o0000000000000000.ingest.us.sentry.io/0000000000000000
