# ─────────────────────────────────────────────────────────
#  ZAPSCRIPT.ME — Environment Variables
#  Copie para .env e preencha antes de iniciar o projeto
# ─────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# ── SUPABASE (banco PostgreSQL) ───────────────────────────
# supabase.com → Settings → Database → Connection String (Transaction mode)
DATABASE_URL=postgresql://postgres.REF:SENHA@aws-1-us-west-2.pooler.supabase.com:6543/postgres
# supabase.com → Settings → Database → Connection String (Direct mode — para migrations)
DIRECT_URL=postgresql://postgres.REF:SENHA@aws-1-us-west-2.pooler.supabase.com:5432/postgres
# supabase.com → Settings → API
SUPABASE_URL=https://REF.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# ── REDIS (Upstash) ───────────────────────────────────────
# upstash.com → Redis → Connect → .env
REDIS_URL=redis://default:SENHA@HOST.upstash.io:6379

# ── OpenAI (Whisper) ──────────────────────────────────────
# platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# ── Anthropic (Claude) ────────────────────────────────────
# console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ── WhatsApp Cloud API (Meta) ──────────────────────────────
# developers.facebook.com → App → WhatsApp
# Gere access token com escopo: whatsapp_business_messaging
WHATSAPP_API_TOKEN=EAAS...TOKEN_AQUI
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_WEBHOOK_TOKEN=GERE_UM_TOKEN_ALEATORIO_PARA_WEBHOOK

# ── ASAAS (pagamentos) ────────────────────────────────────
# app.asaas.com → Configurações → Integrações → API Key
# Sandbox: sandbox.asaas.com — use $aact_... para sandbox
# Produção: app.asaas.com  — use $aact_... para produção
ASAAS_API_KEY=$aact_...

# Configurações → Notificações → Webhooks → URL + Token
# URL: https://zapscript-api.railway.app/billing/webhook
ASAAS_WEBHOOK_TOKEN=GERE_UM_TOKEN_ALEATORIO_AQUI

# ── Tokens Internos ───────────────────────────────────────
# Gerar com: node infra/gen-secrets.js
JWT_SECRET=GERE_COM_CRYPTO_RANDOMBYTES_48_HEX
ENCRYPTION_KEY=GERE_COM_CRYPTO_RANDOMBYTES_32_HEX_64CHARS
INTERNAL_TOKEN=GERE_COM_CRYPTO_RANDOMBYTES_32_HEX
MONITOR_TOKEN=GERE_COM_CRYPTO_RANDOMBYTES_32_HEX
ADMIN_TOKEN=GERE_COM_CRYPTO_RANDOMBYTES_32_HEX

# ── App ───────────────────────────────────────────────────
APP_URL=https://zapscript.me/
APP_NAME=ZapScript
NEXT_PUBLIC_API_URL=https://zapscript.me/
NEXT_PUBLIC_SUPABASE_URL=https://REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_APP_NAME=ZapScript

# ── E-mail (suporte + alertas) ────────────────────────────
# Gmail: use senha de app (myaccount.google.com/apppasswords)
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_USER=ativacao@zapscript.me
SMTP_PASS=Rf691393@
SUPPORT_EMAIL=suporte@zapscript.me

# ── Monitor ───────────────────────────────────────────────
API_HEALTH_URL=https://zapscript-api.railway.app/health
DASHBOARD_URL=https://zapscript.me/dashboard
ALERT_EMAIL=contato@zapscript.me

# ── Sentry (error tracking) ───────────────────────────────
# sentry.io → Create Project → Copy DSN
SENTRY_DSN=https://b58b74229a1e20ac34a02499da861880@o4511334790594560.ingest.us.sentry.io/4511334799114240

