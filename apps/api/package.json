{
  "name": "api",
  "version": "1.0.0",
  "packageManager": "npm@10.0.0",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "prebuild": "npm install --prefix ../../packages/database",
    "build": "prisma generate --schema=../../packages/database/prisma/schema.prisma && mkdir -p node_modules/.prisma && rm -rf node_modules/.prisma/client && cp -r ../../packages/database/node_modules/.prisma/client node_modules/.prisma/ && tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "5.22.0",
    "@sentry/node": "^10.76.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "2.105.1",
    "axios": "^1.20.0",
    "bullmq": "^5.81.5",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.0.13",
    "openai": "^4.104.0",
    "pino": "^9.14.0",
    "resend": "^6.32.0",
    "socket.io": "^4.8.4",
    "ws": "8.21.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prisma": "5.22.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
