{
  "name": "worker",
  "version": "1.0.0",
  "packageManager": "npm@10.0.0",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "prebuild": "npm install --prefix ../../packages/database",
    "build": "prisma generate --schema=../../packages/database/prisma/schema.prisma && mkdir -p node_modules/.prisma && rm -rf node_modules/.prisma/client && cp -r ../../packages/database/node_modules/.prisma/client node_modules/.prisma/ && tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@prisma/client": "5.22.0",
    "@sentry/node": "^10.76.0",
    "@supabase/supabase-js": "2.105.1",
    "axios": "^1.20.0",
    "bullmq": "^5.81.5",
    "dotenv": "^16.6.1",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.11.1",
    "openai": "^4.104.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prisma": "5.22.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
