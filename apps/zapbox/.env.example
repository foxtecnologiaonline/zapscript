# ── Banco de dados (independente do ZapScript.me) ──────────────────────────
ZAPBOX_DATABASE_URL="postgresql://user:pass@host:5432/zapbox"

# ── Auth ────────────────────────────────────────────────────────────────────
ZAPBOX_JWT_SECRET="gere-um-valor-aleatorio-longo-aqui"

# ── Evolution API (Fase 1) ──────────────────────────────────────────────────
# Pode ser o MESMO servidor Evolution que já roda no Vultr do ZapScript.me
# (uma instância Evolution serve N números — só usar prefixo zb- já evita
# colisão com os zs- do ZapScript.me) ou um servidor Evolution dedicado.
ZAPBOX_EVOLUTION_API_URL="https://evolution.seu-dominio.com"
ZAPBOX_EVOLUTION_API_KEY="sua-apikey-global-da-evolution"

# ── URL pública desta aplicação (usada para montar a webhook URL enviada à
#    Evolution ao criar cada instância) ──────────────────────────────────────
ZAPBOX_PUBLIC_URL="https://zapbox.seu-dominio.com"
