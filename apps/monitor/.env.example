# ── ZapScript Monitor — Variáveis de Ambiente ──────────────────
# Copie para .env e preencha

# URLs a monitorar (padrão usa produção)
API_URL=https://zapscript-api.railway.app/health
APP_URL=https://zapscript.me
DASHBOARD_URL=https://zapscript.me/dashboard

# Claude AI (para análise de problemas)
ANTHROPIC_API_KEY=sk-ant-...

# ── Alertas por Email ──────────────────────────────────────────
# Deixe em branco para desativar alertas por email
ALERT_EMAIL=seu@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=sua-senha-app-google

# ── Alertas por WhatsApp ───────────────────────────────────────
# Número que vai receber o alerta (com código do país, sem +)
ALERT_WHATSAPP_PHONE=5511999999999
# Token interno da API ZapScript para enviar mensagem
MONITOR_TOKEN=
