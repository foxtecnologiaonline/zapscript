# Copie para .env  (cp .env.example .env)  e preencha. NÃO comite o .env.
#
# Versão da imagem: use a MESMA que roda hoje na Hostinger.
# Verifique lá com:  docker ps --format '{{.Image}}'
EVO_VERSION=v2.1.1

# Subdomínio público que você criará no DNS (registro A → IP do VPS OCI)
DOMAIN=evo.zapscript.me

# Chave de acesso à API do Evolution. Gere com: openssl rand -hex 32
AUTHENTICATION_API_KEY=COLE_AQUI_openssl_rand_hex_32

# Senha do Postgres interno (qualquer string forte). Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=COLE_AQUI_openssl_rand_hex_24
