# ── ZapScript — Variáveis a cadastrar na UI do Coolify ────────────────────────
# NÃO é um .env pra colocar no servidor — o Coolify não lê arquivo .env do disco
# pra Docker Compose resources. Copie cada linha abaixo e cadastre em:
#   Coolify → Project "zapscript" → Resource → Environment Variables
# (marque "Is Build Variable" = não, exceto se algum dia precisar em build args)
#
# Depois de cadastradas, o Coolify substitui ${VAR} no
# infra/coolify/docker-compose.coolify.yml automaticamente a cada deploy.

# ── Imagem ────────────────────────────────────────────────────────────────
IMAGE_TAG=latest

# ── Banco de dados (Supabase — mesmo do ambiente atual) ────────────────────
DATABASE_URL=postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Redis (container interno do Coolify, não exposto) ───────────────────────
# Gerar: openssl rand -hex 32
REDIS_PASSWORD=

# ── Segredos internos ────────────────────────────────────────────────────────
# Gerar: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
# Gerar: openssl rand -hex 16
INTERNAL_TOKEN=
MONITOR_TOKEN=

# ── IA ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ── WhatsApp — Evolution API ─────────────────────────────────────────────────
# Se o serviço evolution NÃO tiver domínio público (recomendado), aponte pra
# um valor qualquer coerente (não é usado pra roteamento externo, só aparece
# em respostas internas da própria Evolution).
EVOLUTION_PUBLIC_URL=https://evo.zapscript.me
# Gerar: openssl rand -hex 24
EVOLUTION_API_KEY=

# ── Pagamentos (Asaas) ─────────────────────────────────────────────────────
ASAAS_API_KEY=
# Gerar: openssl rand -hex 16
ASAAS_WEBHOOK_TOKEN=

# ── App ────────────────────────────────────────────────────────────────────
APP_URL=https://zapscript.me
SENTRY_DSN=

# ── Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_EMAIL=suporte@zapscript.me

# ── Worker ─────────────────────────────────────────────────────────────────
FFMPEG_TIMEOUT_MS=300000
WORKER_CONCURRENCY=2
WORKER_LOCK_MINUTES=5
