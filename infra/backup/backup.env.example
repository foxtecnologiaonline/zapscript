# /etc/zapscript/backup.env  (chmod 600, dono root) — NUNCA versionar a versão preenchida.
# Origem dos dados
BV_PG_URL=postgresql://backup_ro:SENHA@postgres:5432/zapscript     # usuário só-leitura (pg_dump); sslmode=require se remoto
BV_STORAGE_DIR=/var/lib/zapscript/bv-storage                       # mesmo valor de BV_STORAGE_DIR da API

# Cifra (um dos dois). A chave NÃO fica no repositório nem neste arquivo.
# Preferido — age (assimétrico): o servidor só tem a chave pública; a privada fica com a custódia do órgão/DPO.
#   age-keygen -o age-identity.key     (guarde a privada OFFLINE; cole aqui só a linha "Public key")
BV_BACKUP_AGE_RECIPIENT=
# Alternativa — openssl AES-256-CBC+PBKDF2 com arquivo de chave:  openssl rand -base64 48 > backup.key; chmod 600
BV_BACKUP_KEY_FILE=/etc/zapscript/backup/backup.key
# Só para RESTAURAR (nunca no servidor de produção):
# BV_BACKUP_AGE_IDENTITY_FILE=/run/secrets/backup/age-identity.key

# Local, rotação e status (a API lê o status: mesma variável no .env da API)
BV_BACKUP_DIR=/var/backups/zapscript
BV_BACKUP_STATUS_FILE=/var/backups/zapscript/status.json
BV_BACKUP_KEEP_DAILY=7
BV_BACKUP_KEEP_WEEKLY=4
BV_BACKUP_KEEP_MONTHLY=12
BV_BACKUP_AT=03:15                      # UTC, só no agendador do container

# Cópia externa — OBRIGATÓRIA para o requisito de DR (outra zona/região DO BRASIL). Um dos dois:
BV_BACKUP_UPLOADER=                     # aws | rclone
BV_BACKUP_S3_URI=                       # s3://bucket-br/zapscript   (aws)
BV_BACKUP_S3_ENDPOINT=                  # endpoint S3-compatível do provedor no Brasil (aws)
BV_BACKUP_RCLONE_DEST=                  # remoto:bucket/zapscript    (rclone; config em ~/.config/rclone)
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=  (credencial de ESCRITA apenas; sem permissão de apagar — ver README)

# Alerta opcional (POST JSON {"text":...}) em falha
BV_BACKUP_ALERT_WEBHOOK=
