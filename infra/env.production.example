NODE_ENV=production
PORT=3001

# ── Banco de dados (Supabase) ──────────────────────────────────────────────
# Supabase → Settings → Database → Connection String (URI)
DATABASE_URL=postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres

# ── Redis (Upstash) ────────────────────────────────────────────────────────
# Upstash → Redis → Connect → .env
REDIS_URL=redis://default:[SENHA]@[HOST].upstash.io:6379

# ── Segredos internos ──────────────────────────────────────────────────────
# Gerar: openssl rand -hex 32
JWT_SECRET=GERAR_OPENSSL_RAND_HEX_32
# Gerar: openssl rand -hex 32
ENCRYPTION_KEY=GERAR_OPENSSL_RAND_HEX_32
# Gerar: openssl rand -hex 16
INTERNAL_TOKEN=GERAR_OPENSSL_RAND_HEX_16
# Gerar: openssl rand -hex 16
MONITOR_TOKEN=GERAR_OPENSSL_RAND_HEX_16

# ── IA ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# ── WhatsApp — Evolution API (roda no mesmo servidor via Docker) ───────────
# A URL interna usa o nome do container Docker
EVOLUTION_API_URL=http://evolution:8080
# Token forte — você define (ex: openssl rand -hex 24)
EVOLUTION_API_KEY=GERAR_TOKEN_FORTE
# Gerar: openssl rand -hex 24
EVOLUTION_WEBHOOK_SECRET=GERAR_OPENSSL_RAND_HEX_24

# ── Pagamentos (Asaas) ─────────────────────────────────────────────────────
# Sandbox: $aact_test_... | Produção: $aact_...
ASAAS_API_KEY=$aact_...
# Gerar: openssl rand -hex 16
ASAAS_WEBHOOK_TOKEN=GERAR_OPENSSL_RAND_HEX_16

# ── App ────────────────────────────────────────────────────────────────────
APP_URL=https://zapscript.me
SENTRY_DSN=

# ── Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=google-app-password
SUPPORT_EMAIL=suporte@zapscript.me

# ── Worker (variáveis internas) ────────────────────────────────────────────
API_URL=http://api:3001
WORKER_CONCURRENCY=2
WORKER_LOCK_MINUTES=5
