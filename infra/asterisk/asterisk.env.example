# Exemplo — copie para asterisk.env e preencha. NÃO versione o arquivo preenchido.
# As mesmas BV_ARI_* / BV_SIP_SECRET / BV_AGENT_EXT_* precisam estar no .env da API (ver docs/balcao/api-voice.md).

# ── obrigatórias ─────────────────────────────────────────────────────────────
BV_ARI_USER=balcao
BV_ARI_PASS=TROQUE-gere-com-openssl-rand-hex-24
BV_SIP_SECRET=TROQUE-gere-com-openssl-rand-hex-32
BV_EXTERNAL_IP=216.238.120.65

# ── ramais dos atendentes (WebRTC) ───────────────────────────────────────────
BV_AGENT_EXT_START=1001
BV_AGENT_EXT_END=1050
# BV_AGENT_CODECS=opus,ulaw,alaw
# Ramal de TESTE que simula o tronco (telefone SIP comum → entra na URA). Só bancada/PoC.
# BV_TEST_CALLER_EXT=9001

# ── WSS (certificado em ./keys) ──────────────────────────────────────────────
# BV_WSS_CERT=/etc/asterisk/keys/fullchain.pem
# BV_WSS_KEY=/etc/asterisk/keys/privkey.pem
# SÓ desenvolvimento (navegador recusa autoassinado até você confiar nele):
# BV_WSS_SELF_SIGNED=1

# ── RTP (a faixa publicada no compose segue estes valores) ───────────────────
BV_RTP_START=10000
BV_RTP_END=10200
# BV_STUN_SERVER=stun.l.google.com:19302

# ── tronco SIP com a VoIP do TJTO (vazio = sem tronco) ───────────────────────
# BV_TRUNK_HOST=sbc.tjto.example
# BV_TRUNK_PORT=5060
# BV_TRUNK_TRANSPORT=transport-udp
# BV_TRUNK_AUTH=ip                 # ip | registration | userpass
# BV_TRUNK_IPS=203.0.113.10,203.0.113.11
# BV_TRUNK_USER=
# BV_TRUNK_PASS=
# BV_TRUNK_CODECS=ulaw,alaw
# BV_TRUNK_FROM_USER=balcao
# BV_TRUNK_FROM_DOMAIN=
# BV_LANGUAGE=pt_BR                # só se instalou os sons pt_BR (CORE_SOUNDS_PT_URL no build)

# ── build / compose (lidos pelo docker compose, não pelo container) ──────────
# ASTERISK_VERSION=20-current
# ASTERISK_UID=1000
# CORE_SOUNDS_PT_URL=
# BV_DOCKER_NETWORK=zapscript
# BV_MOH_DIR=./moh
# BV_KEYS_DIR=./keys
