# /opt/zapscript/ha.env — usado com `docker compose --env-file`. chmod 600; NÃO versionar a versão preenchida.
REDIS_PASSWORD=troque-por-uma-senha-longa-e-aleatoria     # openssl rand -hex 32
BV_ENV_FILE=/opt/zapscript/.env                            # .env da API (JWT_SECRET, ENCRYPTION_KEY, BV_FIELD_KEYS, DATABASE_URL...)
BV_STORAGE_HOST_DIR=/var/lib/zapscript/bv-storage
BV_BACKUP_HOST_DIR=/var/backups/zapscript
BV_DOCKER_NETWORK=zapscript_zapscript
# Só declare BR depois de confirmar a residência de TODOS os componentes (docs/balcao/INFRA-BR-CERTIFICACOES.md)
BV_DATA_RESIDENCY=
